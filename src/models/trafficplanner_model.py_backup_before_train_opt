    def freeze_z_global(self):
        """
        Freeze z_global encoder (prior_net, posterior_net) for Phase 2 training.
        After Phase 1 (traffic model training), freeze these to only train z_local.
        """
        # Freeze prior and posterior networks
        for param in self.prior_net.parameters():
            param.requires_grad = False
        for param in self.posterior_net.parameters():
            param.requires_grad = False

        # Freeze past/future encoders
        for param in self.past_encoder.parameters():
            param.requires_grad = False
        if hasattr(self, 'past_out_layer'):
            for param in self.past_out_layer.parameters():
                param.requires_grad = False
        for param in self.future_encoder.parameters():
            param.requires_grad = False
        if hasattr(self, 'future_out_layer'):
            for param in self.future_out_layer.parameters():
                param.requires_grad = False

        # Freeze map encoder
        for param in self.map_conv.parameters():
            param.requires_grad = False
        for param in self.map_feature.parameters():
            param.requires_grad = False

        Logger.log('Frozen z_global encoder (prior, posterior, past/future/map encoders)')

    def unfreeze_z_global(self):
        """
        Unfreeze z_global encoder for joint training or fine-tuning.
        """
        for param in self.prior_net.parameters():
            param.requires_grad = True
        for param in self.posterior_net.parameters():
            param.requires_grad = True

        for param in self.past_encoder.parameters():
            param.requires_grad = True
        if hasattr(self, 'past_out_layer'):
            for param in self.past_out_layer.parameters():
                param.requires_grad = True
        for param in self.future_encoder.parameters():
            param.requires_grad = True
        if hasattr(self, 'future_out_layer'):
            for param in self.future_out_layer.parameters():
                param.requires_grad = True

        for param in self.map_conv.parameters():
            param.requires_grad = True
        for param in self.map_feature.parameters():
            param.requires_grad = True

        Logger.log('Unfrozen z_global encoder')

    def get_z_local(self):
        """
        Get z_local samples from the last forward pass for sparsity loss computation.
        Returns stacked z_local across all timesteps.

        :return: (FT, num_ego, z_local_size) or (FT, num_ego, NS, z_local_size) if batched
        """
        if not hasattr(self, '_z_local_outputs') or len(self._z_local_outputs) == 0:
            return None
        return torch.stack(self._z_local_outputs, dim=0)

    def get_z_local_mean(self):
        """
        Get z_local mean from the last forward pass for analysis/clustering.
        Returns stacked z_local_mean across all timesteps.

        :return: (FT, num_ego, z_local_size) or (FT, num_ego, NS, z_local_size) if batched
        """
        if not hasattr(self, '_z_local_mean_outputs') or len(self._z_local_mean_outputs) == 0:
            return None
        return torch.stack(self._z_local_mean_outputs, dim=0)

    def get_z_local_var(self):
        """
        Get z_local variance from the last forward pass for analysis/clustering.
        Returns stacked z_local_var across all timesteps.

        :return: (FT, num_ego, z_local_size) or (FT, num_ego, NS, z_local_size) if batched
        """
        if not hasattr(self, '_z_local_var_outputs') or len(self._z_local_var_outputs) == 0:
            return None
        return torch.stack(self._z_local_var_outputs, dim=0)

    def get_z_local_sparsity_loss(self, target_sparsity=0.1):
        """
        Compute sparsity loss for z_local to encourage minimal deviation from z_global.

        The idea: z_local should only activate when necessary (reactive maneuvers),
        otherwise it should be close to zero (relying on z_global).

        :param target_sparsity: target fraction of active z_local dimensions
        :return: sparsity loss scalar
        """
        z_local = self.get_z_local()
        if z_local is None:
            return torch.tensor(0.0)

        # L1 sparsity: encourage z_local to be sparse
        l1_loss = torch.mean(torch.abs(z_local))

        # Optional: KL divergence to encourage specific sparsity level
        # Using mean activation as proxy for sparsity
        mean_activation = torch.mean(torch.abs(z_local), dim=-1)  # per ego per timestep
        sparsity_target = torch.full_like(mean_activation, target_sparsity)
        kl_loss = torch.mean((sparsity_target * torch.log(sparsity_target / (mean_activation + 1e-8) + 1e-8) +
                              (1 - sparsity_target) * torch.log((1 - sparsity_target) / (1 - mean_activation + 1e-8) + 1e-8)))

        return l1_loss + 0.1 * kl_loss

